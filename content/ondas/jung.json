  "ethics": [
    {
      "title": "Own your shadow",
      "text": "What you refuse to see, you will project onto others."
    },
    {
      "title": "Become whole, not perfect",
      "text": "Jung: I would rather be whole than good."
    },
    {
      "title": "Take symbols seriously",
      "text": "Dreams and images carry meaning you did not choose."
    }
  ],
  "philosophy": [
    {
      "title": "The unconscious is not empty",
      "text": "It holds what you have not lived."
    },
    {
      "title": "Archetypes",
      "text": "The Hero, Mother, Trickster and Wise Old Man recur across cultures."
    },
    {
      "title": "The two halves of life",
      "text": "Morning builds the self, afternoon asks what it was for."
    },
    {
      "title": "Synchronicity",
      "text": "Inner and outer events can rhyme in meaning."
    }
  ],
  "journal": [
    "What was the last dream, and what stayed with you?",
    "Who irritated you today, and what might that be about you?",
    "What image keeps returning?",
