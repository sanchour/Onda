  "journal": [
    "What did you notice outdoors that you had not before?",
    "What did you do today because of the crowd, and what because of you?",
    "What could you live without?",
    "What conviction would you follow if no one watched?",
    "What was the best hour of the day?",
    "What did you read that spoke to you?",
    "What would living deliberately change tomorrow?"
  ],
  "reflect": [
    "What did you simplify, and what returned?",
    "Which practice changed you the most, and why?",
    "What will you keep of this slower life?"
  ],
