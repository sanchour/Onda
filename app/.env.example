# Copy to app/.env.local. All three are optional: without them Onda runs in local mode
# (everything on-device; sync, integrations, push and checkout report "not configured").
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Same value as VAPID_PUBLIC_KEY in supabase/functions/.env
VITE_VAPID_PUBLIC_KEY=
