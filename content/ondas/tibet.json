  "philosophy": [
    {
      "title": "Emptiness",
      "text": "Things have no fixed, independent nature. Everything arises from conditions."
    },
    {
      "title": "Interdependence",
      "text": "Everything you use came from countless beings."
    },
    {
      "title": "Impermanence",
      "text": "All composed things end."
    },
    {
      "title": "Karma",
      "text": "Intentional actions leave traces and shape what comes."
    }
