        "bio": "Legendary monk said to bring Chan to China from India."
      },
      {
        "name": "Huineng",
        "dates": "",
        "bio": "Sixth Patriarch of Chan. His sermon is the Platform Sutra."
      },
      {
        "name": "Dōgen",
        "dates": "",
        "bio": "Founded Sōtō Zen in Japan and wrote the Shōbōgenzō."
      },
      {
        "name": "Hakuin",
        "dates": "",
        "bio": "Revived Rinzai koan practice. Said to have asked the sound of one hand."
      }
    ],
    "history": [
