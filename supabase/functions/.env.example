# Edge Function secrets. Set them with: supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the platform.)

# Comma-separated origins allowed to call the functions and to be redirected back to.
APP_ORIGINS=https://onda.example.com,http://localhost:5173

# 32 random bytes, base64. Encrypts Notion tokens and signs OAuth state. openssl rand -base64 32
ENCRYPTION_KEY=

# Shared secret for pg_cron -> function calls. Must equal the Vault secret onda_cron_secret.
CRON_SECRET=

# Notion public integration (https://www.notion.so/my-integrations). Redirect URI:
#   https://<project-ref>.supabase.co/functions/v1/notion-oauth
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Stripe: one-time Price for Ondas+ lifetime (EUR 14.99) and the webhook signing secret for
#   https://<project-ref>.supabase.co/functions/v1/stripe-webhook
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# The recurring monthly price for Ondas+ (EUR 2,49). STRIPE_PRICE_ID above is the one-time lifetime price (EUR 24,99).
STRIPE_PRICE_MONTHLY=
STRIPE_WEBHOOK_SECRET=

# Web Push (VAPID). npx web-push generate-vapid-keys. The public key also goes in app/.env as VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# iCloud link of the signed "Onda Reminders" shortcut (see docs/SHORTCUT.md). Optional until published.
SHORTCUT_URL=
