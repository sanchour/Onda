{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview",
      "startServerReadyPattern": "Local",
      "url": ["http://localhost:4173/?seed=demo"],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop", "formFactor": "mobile", "screenEmulation": { "mobile": true, "width": 393, "height": 852, "deviceScaleFactor": 3, "disabled": false }, "onlyCategories": ["performance", "accessibility", "best-practices", "seo", "pwa"], "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 1500 }],
        "installable-manifest": "error",
        "service-worker": "error",
        "viewport": "error",
        "themed-omnibox": "error",
        "maskable-icon": "error"
      }
    }
  }
}
