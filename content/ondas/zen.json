  "philosophy": [
    {
      "title": "Beginner’s mind",
      "text": "Expert minds see few possibilities. Beginner minds see many."
    },
    {
      "title": "No separate self",
      "text": "Self and world arise together."
    },
    {
      "title": "Impermanence",
      "text": "Everything arises and passes. Hold lightly."
    },
    {
      "title": "Just this",
      "text": "No better moment is coming. This one is the practice."
    }
  ],
  "journal": [
    "When were you fully where you were today?",
    "What did you notice once you stopped reaching?",
    "What did you do with your hands that deserved full attention?",
    "Where did you rush? What was the rush for?",
    "What did you leave unfinished and let be?",
    "What sound did you hear today that you usually miss?",
    "What is left when you remove the commentary?"
  ],
  "reflect": [
