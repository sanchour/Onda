{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/chrome/**",
              "components/content/**",
              "components/controls/**",
              "components/data/**",
              "components/flow/**",
              "components/icons/**",
              "components/insights/**",
              "components/lists/**",
              "components/motion/**",
              "components/navigation/**",
              "components/overlays/**",
              "ui_kits/journal/**",
              "ui_kits/notes/**",
              "ui_kits/shared/**",
              "ui_kits/tasks/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|DM Sans|Unbounded|Newsreader))/i]",
        "message": "Font not provided by the design system. Available: Inter, DM Sans, Unbounded, Newsreader."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|weight|label|destructive|onClick|key|ref|className|style|children)$/]",
        "message": "<ActionTile> doesn't accept that prop. Declared props: icon, weight, label, destructive, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionTile'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:regular|bold|fill)$/]",
        "message": "<ActionTile> weight must be one of 'regular' | 'bold' | 'fill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|size|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: initials, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|size|x|y|color|z|key|ref|className|style|children)$/]",
        "message": "<Bubble> doesn't accept that prop. Declared props: label, size, x, y, color, z."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|fullWidth|icon|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, fullWidth, icon, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|inverse|secondary|plain)$/]",
        "message": "<Button> variant must be one of 'primary' | 'inverse' | 'secondary' | 'plain'."
